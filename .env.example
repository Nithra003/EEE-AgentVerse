# Elder-AI Environment Configuration
# Copy this file to .env and update with your configuration

# Response Agent Address
# Get this from the Response Agent output when it starts
# Format: agent1q<hex_string>
# Example: RESPONSE_AGENT_ADDRESS=agent1qz84c5d7qg5qx4t6w5e8v7k0n3m2b5s8a1d4f7h0j3k6m9p2r5t8v1x4z7
RESPONSE_AGENT_ADDRESS=

# Detection Agent Port (default: 8001)
# DETECTION_AGENT_PORT=8001

# Response Agent Port (default: 8002)
# RESPONSE_AGENT_PORT=8002

# Monitor Name (for display purposes)
# MONITOR_NAME=John Doe

# Monitor Location (for display purposes)
# MONITOR_LOCATION=Living Room

# Emergency Contact Names (for display purposes)
# EMERGENCY_CONTACT_1=Jane Doe
# EMERGENCY_CONTACT_2=St. Mary's Hospital
