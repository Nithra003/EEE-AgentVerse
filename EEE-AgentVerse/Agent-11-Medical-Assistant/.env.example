# ============================================================
#  AI Medical Assistant — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_VERSION=1.0.0
APP_SECRET_KEY=change-me-to-a-random-32-char-string

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text              # text | json

# ── Database ─────────────────────────────────────────────────
# Leave blank to use the default SQLite path (data/medical_assistant.db)
DATABASE_URL=
DB_ECHO=false                # true = log every SQL statement (dev only)

# ── Ollama / LLM ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120           # seconds

# Model priority order (comma-separated, first = primary)
LLM_MODELS=qwen3,deepseek-r1,llama3.1
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# ── OCR ──────────────────────────────────────────────────────
# Full path to tesseract binary (leave blank if on system PATH)
TESSERACT_CMD=tesseract
OCR_CONFIDENCE_THRESHOLD=0.65
OCR_FALLBACK_THRESHOLD=0.50

# ── Translation ───────────────────────────────────────────────
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
DEFAULT_LANGUAGE=en
TRANSLATION_CACHE_SIZE=512

# ── Voice ─────────────────────────────────────────────────────
WHISPER_MODEL=base           # tiny | base | small | medium | large
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC

# ── Reminders ─────────────────────────────────────────────────
REMINDER_SNOOZE_MINUTES=10
REMINDER_MISSED_THRESHOLD=3
DEFAULT_MORNING_TIME=08:00
DEFAULT_AFTERNOON_TIME=13:00
DEFAULT_NIGHT_TIME=21:00

# ── Feature Flags ─────────────────────────────────────────────
FEATURE_VOICE=true
FEATURE_TRANSLATION=true
FEATURE_OCR=true
FEATURE_REMINDERS=true
FEATURE_APPOINTMENTS=true
